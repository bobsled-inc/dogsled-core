{
  "name": "@bobsled-inc/dogsled",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobsled-inc/dogsled-core.git",
    "directory": "packages/dogsled"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "dogsled": "./bin/cli.mjs"
  },
  "main": "./dist/public-apis.js",
  "types": "./dist/public-apis.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public-apis.d.ts",
      "import": "./dist/public-apis.js",
      "default": "./dist/public-apis.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "import": "./dist/resources/index.js",
      "default": "./dist/resources/index.js"
    },
    "./project-skills": {
      "types": "./dist/project-skills/index.d.ts",
      "import": "./dist/project-skills/index.js",
      "default": "./dist/project-skills/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "default": "./dist/sync/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./reverse-etl": {
      "types": "./dist/reverse-etl/index.d.ts",
      "import": "./dist/reverse-etl/index.js",
      "default": "./dist/reverse-etl/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js",
      "default": "./dist/pipeline/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    },
    "./source-query": {
      "types": "./dist/source-query.d.ts",
      "import": "./dist/source-query.js",
      "default": "./dist/source-query.js"
    },
    "./connections": {
      "types": "./dist/compat/connections.d.ts",
      "import": "./dist/compat/connections.js",
      "default": "./dist/compat/connections.js"
    },
    "./document-parsers": {
      "types": "./dist/compat/document-parsers.d.ts",
      "import": "./dist/compat/document-parsers.js",
      "default": "./dist/compat/document-parsers.js"
