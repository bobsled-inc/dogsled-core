    "./extractor/extractor": {
      "types": "./dist/compat/extractor.d.ts",
      "import": "./dist/compat/extractor.js",
      "default": "./dist/compat/extractor.js"
    },
    "./integrations": {
      "types": "./dist/compat/integrations.d.ts",
      "import": "./dist/compat/integrations.js",
      "default": "./dist/compat/integrations.js"
    },
    "./integrations/catalog": {
      "types": "./dist/compat/integrations-catalog.d.ts",
      "import": "./dist/compat/integrations-catalog.js",
      "default": "./dist/compat/integrations-catalog.js"
    },
    "./model-spec": {
      "types": "./dist/compat/model-spec.d.ts",
      "import": "./dist/compat/model-spec.js",
      "default": "./dist/compat/model-spec.js"
    },
    "./model-spec/project": {
      "types": "./dist/compat/model-spec-project.d.ts",
