      "types": "./dist/compat/model-spec-schemas.d.ts",
      "import": "./dist/compat/model-spec-schemas.js",
      "default": "./dist/compat/model-spec-schemas.js"
    },
    "./ai": {
      "types": "./dist/compat/ai.d.ts",
      "import": "./dist/compat/ai.js",
      "default": "./dist/compat/ai.js"
    },
    "./model-spec/agentic": {
      "types": "./dist/compat/model-spec-agentic.d.ts",
      "import": "./dist/compat/model-spec-agentic.js",
      "default": "./dist/compat/model-spec-agentic.js"
    },
    "./agentic": {
      "types": "./dist/agentic.d.ts",
      "import": "./dist/agentic.js",
      "default": "./dist/agentic.js"
    },
    "./model-spec/interchange": {
      "types": "./dist/compat/model-spec-interchange.d.ts",
      "import": "./dist/compat/model-spec-interchange.js",
      "default": "./dist/compat/model-spec-interchange.js"
    },
    "./blueprint-aliases": {
      "types": "./dist/blueprint-aliases.d.ts",
      "import": "./dist/blueprint-aliases.js",
      "default": "./dist/blueprint-aliases.js"
    },
    "./ai/test-stubs": {
      "types": "./dist/compat/ai-test-stubs.d.ts",
      "import": "./dist/compat/ai-test-stubs.js",
      "default": "./dist/compat/ai-test-stubs.js"
    },
    "./ontology": {
      "types": "./dist/compat/ontology.d.ts",
      "import": "./dist/compat/ontology.js",
      "default": "./dist/compat/ontology.js"
    },
    "./sftp": {
      "types": "./dist/compat/sftp.d.ts",
      "import": "./dist/compat/sftp.js",
      "default": "./dist/compat/sftp.js"
