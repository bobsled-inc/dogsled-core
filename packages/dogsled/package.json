  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "examples/",
    "cowork/",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/onboarding-assets.mjs --check && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:cross-warehouse": "vitest run --config vitest.unit.config.ts tests/unit/runtime/cross-warehouse.test.ts tests/unit/runtime/cross-warehouse-schema.test.ts tests/unit/runtime/cross-warehouse-bigquery-smoke.test.ts",
    "test:watch": "vitest",
    "smoke:cross-warehouse:bigquery": "tsx scripts/cross-warehouse-bigquery-duckdb-smoke.ts"
  },
  "dependencies": {
    "@bobsled-inc/api-resource": "workspace:*",
    "@bobsled-inc/ai": "workspace:*",
    "@bobsled-inc/connections": "workspace:*",
    "@bobsled-inc/document-parsers": "workspace:*",
    "@bobsled-inc/embedder": "workspace:*",
    "@bobsled-inc/entity-graph": "workspace:*",
    "@bobsled-inc/extractor": "workspace:*",
    "@bobsled-inc/integrations": "workspace:*",
    "@bobsled-inc/loader": "workspace:*",
    "@bobsled-inc/model-spec": "workspace:*",
    "@bobsled-inc/models": "workspace:*",
    "@bobsled-inc/project-index": "workspace:*",
    "@bobsled-inc/protocol": "workspace:*",
    "@bobsled-inc/sdk-codegen": "workspace:*",
    "@bobsled-inc/skills": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-crypto/sha256-js": "catalog:aws-sdk",
    "@google-cloud/storage": "7.22.0",
    "@polyglot-sql/sdk": "catalog:",
    "@smithy/signature-v4": "catalog:aws-sdk",
    "chalk": "catalog:cli",
    "commander": "catalog:dev-packages",
    "@duckdb/node-api": "catalog:duckdb",
    "jsonpath-plus": "catalog:app-packages",
    "yaml": "catalog:app-packages",
    "zod": "catalog:dev-packages"
  },
  "bundleDependencies": [
    "@bobsled-inc/api-resource",
    "@bobsled-inc/ai",
    "@bobsled-inc/connections",
    "@bobsled-inc/document-parsers",
    "@bobsled-inc/embedder",
    "@bobsled-inc/entity-graph",
    "@bobsled-inc/extractor",
    "@bobsled-inc/integrations",
    "@bobsled-inc/loader",
    "@bobsled-inc/model-spec",
    "@bobsled-inc/models",
    "@bobsled-inc/project-index",
    "@bobsled-inc/protocol",
    "@bobsled-inc/sdk-codegen",
    "@bobsled-inc/skills",
    "zod"
  ],
  "devDependencies": {
    "@types/node": "catalog:dev-packages",
    "@typescript-eslint/eslint-plugin": "catalog:eslint",
    "@typescript-eslint/parser": "catalog:eslint",
    "eslint": "catalog:eslint",
    "globals": "catalog:dev-packages",
    "jsdom": "catalog:",
    "tsup": "catalog:cli",
    "tsx": "catalog:dev-packages",
    "typescript": "catalog:dev-packages",
    "@vitest/coverage-v8": "catalog:testing",
    "vitest": "catalog:testing"
  },
  "description": "Extract, load and model data with YAML project files: the dogsled CLI and its library APIs.",
  "keywords": [
    "dogsled",
    "data-engineering",
    "etl",
    "elt",
    "agent-native",
    "cli",
    "pipelines",
    "agents"
  ],
  "homepage": "https://github.com/bobsled-inc/dogsled-core#readme",
  "bugs": {
    "url": "https://github.com/bobsled-inc/dogsled-core/issues"
