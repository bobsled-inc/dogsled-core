    "directory": "packages/entity-graph"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./runtime/candidate-retrieval": {
      "types": "./dist/runtime/candidate-retrieval/index.d.ts",
      "import": "./dist/runtime/candidate-retrieval/index.js",
      "default": "./dist/runtime/candidate-retrieval/index.js"
    },
    "./runtime/services": {
      "types": "./dist/runtime/services/index.d.ts",
      "import": "./dist/runtime/services/index.js",
      "default": "./dist/runtime/services/index.js"
    },
    "./runtime/executor": {
      "types": "./dist/runtime/executor/index.d.ts",
      "import": "./dist/runtime/executor/index.js",
      "default": "./dist/runtime/executor/index.js"
    },
    "./runtime/mention": {
      "types": "./dist/runtime/mention/index.d.ts",
      "import": "./dist/runtime/mention/index.js",
      "default": "./dist/runtime/mention/index.js"
    },
    "./runtime/relationship": {
      "types": "./dist/runtime/relationship/index.d.ts",
      "import": "./dist/runtime/relationship/index.js",
      "default": "./dist/runtime/relationship/index.js"
    },
    "./compiler/relationship/cross-entity-link": {
      "types": "./dist/compiler/relationship/cross-entity-link.d.ts",
      "import": "./dist/compiler/relationship/cross-entity-link.js",
      "default": "./dist/compiler/relationship/cross-entity-link.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@bobsled-inc/ai": "workspace:*",
    "@bobsled-inc/connections": "workspace:*",
    "@bobsled-inc/extractor": "workspace:*",
    "@bobsled-inc/integrations": "workspace:*",
    "@bobsled-inc/model-spec": "workspace:*",
    "@bobsled-inc/project-index": "workspace:*",
    "@bobsled-inc/protocol": "workspace:*",
    "@polyglot-sql/sdk": "catalog:",
    "chalk": "catalog:cli",
    "commander": "catalog:dev-packages",
    "compromise": "catalog:app-packages",
    "yaml": "catalog:app-packages",
    "zod": "catalog:dev-packages"
  },
  "devDependencies": {
    "@duckdb/node-api": "catalog:duckdb",
    "@types/node": "catalog:dev-packages",
    "@typescript-eslint/eslint-plugin": "catalog:eslint",
    "@typescript-eslint/parser": "catalog:eslint",
    "eslint": "catalog:eslint",
    "globals": "catalog:dev-packages",
    "tsup": "catalog:cli",
    "tsx": "catalog:dev-packages",
    "typescript": "catalog:dev-packages",
    "vitest": "catalog:testing"
  },
  "description": "Declarative identity resolution, survivorship, review, and entity graph workflows for Dogsled.",
  "keywords": [
