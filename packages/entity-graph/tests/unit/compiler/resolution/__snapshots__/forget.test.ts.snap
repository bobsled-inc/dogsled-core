)
SELECT
  incoming.\`tombstone_id\`,
  incoming.\`source_ref\`,
  incoming.\`source_pk_json\`,
  CURRENT_TIMESTAMP,
  'gdpr erasure',
  incoming.\`content_hash\`
FROM incoming_requests incoming
WHERE NOT EXISTS (
