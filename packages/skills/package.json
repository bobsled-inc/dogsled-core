{
  "name": "@bobsled-inc/skills",
  "version": "0.20.224",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobsled-inc/bobsled-core.git",
    "directory": "packages/skills"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./project": {
      "types": "./dist/project/index.d.ts",
      "import": "./dist/project/index.js",
      "default": "./dist/project/index.js"
    },
    "./bobsled": {
      "types": "./dist/bobsled.d.ts",
      "import": "./dist/bobsled.js",
      "default": "./dist/bobsled.js"
    }
  },
  "files": [
    "dist/",
    "content/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pnpm generate:manifest && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "generate:manifest": "tsx scripts/build-manifest.ts && tsx scripts/build-plugins.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "check:generated": "tsx scripts/check-generated.ts"
  },
  "dependencies": {
    "@bobsled-inc/project-index": "workspace:*",
    "yaml": "catalog:app-packages",
    "zod": "catalog:dev-packages"
  },
  "devDependencies": {
    "@types/node": "catalog:dev-packages",
    "@typescript-eslint/eslint-plugin": "catalog:eslint",
    "@typescript-eslint/parser": "catalog:eslint",
    "eslint": "catalog:eslint",
    "globals": "catalog:dev-packages",
    "tsup": "catalog:cli",
    "tsx": "catalog:dev-packages",
    "typescript": "catalog:dev-packages",
    "@vitest/coverage-v8": "catalog:testing",
    "vitest": "catalog:testing"
  },
  "description": "Private Skill documents and Bobsled Core-maintained agent guidance bundled with Bobsled Core.",
  "keywords": [
    "bobsled",
    "data-engineering",
    "etl",
    "elt",
    "agent-native",
    "agent-skills",
    "automation",
    "workflows"
  ],
  "homepage": "https://github.com/bobsled-inc/bobsled-core#readme",
  "bugs": {
    "url": "https://github.com/bobsled-inc/bobsled-core/issues"
  }
}
